# Cursor TEAM Admin API key (crsr_...), created by a team admin at
# cursor.com/dashboard -> API Keys. A personal API key is NOT the same thing: it answers
# on /v1/me and the Cloud Agents API but every /teams endpoint rejects it with
# "Invalid Team API Key". Run `npm run preflight` to check which kind you have.
# Local development only. In AWS this comes from Secrets Manager via CURSOR_API_KEY_SECRET_ID.
CURSOR_API_KEY=

# Optional: read the key from Secrets Manager instead of the env var.
CURSOR_API_KEY_SECRET_ID=
AWS_REGION=us-east-1

# Override only for testing against a mock server.
CURSOR_API_BASE_URL=https://api.cursor.com

# Postgres. The ingester needs write access.
DATABASE_URL=postgres://zmc:password@localhost:5432/zero_manual_coding
PGSSLMODE=

# Ingestion tuning.
# Days of already-ingested history to re-fetch on every run, because Cursor
# aggregates hourly and late events land after the day closes.
INGEST_LOOKBACK_DAYS=3

# Master key for the AES-256-GCM envelope around everyone's Cursor, GitHub and Jira
# credentials: 32 random bytes, base64. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes every stored credential unreadable and everyone has to reconnect.
# Changing it does the same, so rotate by re-encrypting rather than by editing this.
# The web app and the CLIs must be given the same value or one cannot open what the
# other sealed.
ENCRYPTION_KEY=

# Who may sign in at /login, as a comma-separated list of email domains. A Cursor API key
# is optional at sign-in, so this is the only access control there is. Unset means anyone
# who can reach the app, which is right for a laptop and wrong for a deployment.
ALLOWED_EMAIL_DOMAINS=

# How long a session lasts before someone has to sign in again.
SESSION_LIFETIME_DAYS=14
