# Read-write role. The whole of this product is written by the people using it —
# achievements, commands, rules, resources, sessions, connected credentials — so there is
# no read-only half to separate out. The public landing page reads through the same pool.
DATABASE_URL=postgres://zmc_app:password@localhost:5432/zero_manual_coding

PGSSLMODE=

# Connection pool. The default of 5 is right for a real Postgres and wrong for local
# development: `npm run dev:db` runs PGlite, which serves one client at a time and resets
# the connection rather than queueing, so set these to 1 and 500 in .env.local.
# start-local.cmd already does that for you.
PG_POOL_MAX=5
PG_IDLE_TIMEOUT_MS=10000

# Must match the value the CLIs use, or the app cannot open the credentials the CLIs
# sealed and vice versa. See the repo-root .env.example for how to generate it.
ENCRYPTION_KEY=

# Sign-in at /login. Set this in any deployment. A Cursor API key is optional at sign-in,
# so this list is the only thing deciding who gets an account: unset means anyone who can
# reach the app can sign in as any address they care to type.
ALLOWED_EMAIL_DOMAINS=

SESSION_LIFETIME_DAYS=14

# Comma-separated emails allowed to moderate: hiding an achievement, refreshing the news
# feed, featuring a resource. Team owners from the Cursor roster are admins automatically
# when a team Admin API key has been used to ingest the roster.
ADMIN_EMAILS=
